{
    "name": "skeeks/cms-communication",
    "description": "Communications for SkeekS CMS CRM: mailboxes, messenger bots, conversations, client notifications and mailings linked to leads, companies and clients",
    "keywords": ["yii", "skeeks", "cms", "crm", "email", "imap", "messenger", "notifications"],
    "homepage": "https://cms.skeeks.com/",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://skeeks.com/",
        "wiki": "https://cms.skeeks.com/docs/",
        "source": "https://github.com/skeeks-cms/cms-communication"
    },
    "authors": [
        {
            "name": "Semenov Alexander",
            "email": "semenov@skeeks.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "skeeks/cms": "^6.4.9.59 || dev-master",
        "skeeks/cms-job": "^1.4.0"
    },
    "suggest": {
        "skeeks/cms-agent": "periodic polling of mailboxes and bots",
        "skeeks/cms-communication-imap": "IMAP/SMTP mailboxes"
    },
    "autoload": {
        "psr-4": {
            "skeeks\\cms\\communication\\": "src/"
        }
    }
}
